{
  "name": "gherklin",
  "version": "1.0.14",
  "description": "A linter for Gherkin syntax",
  "author": "Carl Markham <admin@gherklin.com>",
  "license": "ISC",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "keywords": [
    "gherkin",
    "linter"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "gherklin": "dist/bin/gherklin.js"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "test": "node --import tsx scripts/run-unit-tests.mjs",
    "test:unit": "node --import tsx scripts/run-unit-tests.mjs",
    "acceptance": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js --config tests/acceptance/cucumber.mjs",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "gherklin": "tsx ./src/bin/gherklin.ts",
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node -e \"require('fs').mkdirSync('dist/reporters', {recursive: true}); require('fs').copyFileSync('src/reporters/template.html', 'dist/reporters/template.html')\"",
    "prepublishOnly": "pnpm run build",
    "dev:cli": "tsx ./src/bin/gherklin.ts",
    "lint:features": "tsx ./src/bin/gherklin.ts",
    "lint:features:report": "tsx ./src/bin/gherklin.ts --config gherklin.config.report.yaml"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "chalk": "^6.0.1",
    "cosmiconfig": "^10.0.1",
    "handlebars": "^4.7.10",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3"
  }
}
